<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Web Modeler" exporterVersion="64767e4" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.10.0">
  <bpmn:collaboration id="Collaboration_1d9h6ra">
    <bpmn:participant id="Participant_00hz6ia" name="Inventory and Seasonal Availability Management" processRef="Process_1gm24cd" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1gm24cd" name="UC1-02 Inventory and Seasonal Availability" isExecutable="true">
    <bpmn:laneSet id="LaneSet_0wq81wf">
      <bpmn:lane id="Lane_1uxhak8" name="Producer">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_17nmd8k</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1u8ebqz" name="Marketplace system">
        <bpmn:flowNodeRef>Activity_08fju5o</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_1dccpa9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_0cgk0u5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_1hlfmdu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_1h1w4wy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_0ko5z2h</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_17pqnzj</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_1qy9jg7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_0uuhrgw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_00mine8</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="Producer wants to update product availability">
      <bpmn:outgoing>Flow_19db28g</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Activity_17nmd8k" name="Update product quantity and availability period">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="Form_1xcw9bp" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_19db28g</bpmn:incoming>
      <bpmn:outgoing>Flow_1qgdgre</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_19db28g" sourceRef="StartEvent_1" targetRef="Activity_17nmd8k" />
    <bpmn:sequenceFlow id="Flow_1qgdgre" sourceRef="Activity_17nmd8k" targetRef="Activity_08fju5o" />
    <bpmn:serviceTask id="Activity_08fju5o" name="Validate updated stock and availability details">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="validate-product-availability" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1qgdgre</bpmn:incoming>
      <bpmn:outgoing>Flow_18oh2qp</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_1dccpa9" name="Is product within availability period?">
      <bpmn:incoming>Flow_18oh2qp</bpmn:incoming>
      <bpmn:outgoing>Flow_1vs2p12</bpmn:outgoing>
      <bpmn:outgoing>Flow_0pkhk9i</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_18oh2qp" sourceRef="Activity_08fju5o" targetRef="Gateway_1dccpa9" />
    <bpmn:serviceTask id="Activity_0cgk0u5" name="Check available stock quantity">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="check-stock-quantity" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1vs2p12</bpmn:incoming>
      <bpmn:outgoing>Flow_08xwmoi</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_1vs2p12" name="yes" sourceRef="Gateway_1dccpa9" targetRef="Activity_0cgk0u5">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">== date(availabilityStartDate) &lt;= today() and date(availabilityEndDate) &gt;= today()</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="Activity_1hlfmdu" name="Mark product as out of season and unavailable">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="mark-product-out-of-season" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0pkhk9i</bpmn:incoming>
      <bpmn:outgoing>Flow_1tqas9k</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_0pkhk9i" name="No" sourceRef="Gateway_1dccpa9" targetRef="Activity_1hlfmdu">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">== date(availabilityStartDate) &gt; today() or date(availabilityEndDate) &lt; today()</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:exclusiveGateway id="Gateway_1h1w4wy" name="Is available stock quantity greater than zero?">
      <bpmn:incoming>Flow_08xwmoi</bpmn:incoming>
      <bpmn:outgoing>Flow_138rkvz</bpmn:outgoing>
      <bpmn:outgoing>Flow_1id1cp6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_08xwmoi" sourceRef="Activity_0cgk0u5" targetRef="Gateway_1h1w4wy" />
    <bpmn:serviceTask id="Activity_0ko5z2h" name="Mark product as available">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="mark-product-available" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_138rkvz</bpmn:incoming>
      <bpmn:outgoing>Flow_0bicnf8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_138rkvz" name="Yes" sourceRef="Gateway_1h1w4wy" targetRef="Activity_0ko5z2h">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">== stockQuantity &gt; 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="Activity_17pqnzj" name="Mark product as out of stock and unavailable">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="mark-product-out-of-stock" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1id1cp6</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_1id1cp6" name="No" sourceRef="Gateway_1h1w4wy" targetRef="Activity_17pqnzj">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">== stockQuantity = 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1tqas9k" sourceRef="Activity_1hlfmdu" targetRef="Gateway_1qy9jg7" />
    <bpmn:exclusiveGateway id="Gateway_1qy9jg7" name="Combine product availability outcomes">
      <bpmn:incoming>Flow_1tqas9k</bpmn:incoming>
      <bpmn:incoming>Flow_0bicnf8</bpmn:incoming>
      <bpmn:outgoing>Flow_05dncp6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_0bicnf8" sourceRef="Activity_0ko5z2h" targetRef="Gateway_1qy9jg7" />
    <bpmn:serviceTask id="Activity_0uuhrgw" name="Notify producer of updated product availability">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="notify-producer-availability" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_05dncp6</bpmn:incoming>
      <bpmn:outgoing>Flow_0dxky5l</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_05dncp6" sourceRef="Gateway_1qy9jg7" targetRef="Activity_0uuhrgw" />
    <bpmn:endEvent id="Event_00mine8" name="Product availability updated">
      <bpmn:incoming>Flow_0dxky5l</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0dxky5l" sourceRef="Activity_0uuhrgw" targetRef="Event_00mine8" />
  </bpmn:process>
